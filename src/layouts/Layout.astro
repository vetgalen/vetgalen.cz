---
import 'modern-normalize/modern-normalize.css'
import 'animate.css'
import '../scss/global.scss'

import Navi from '../components/Navi/index.astro'
import Footer from '../components/Footer/index.astro'
import CookieConsent from '../components/CookieConsent/index.jsx'

interface Props {
  title: string
  description?: string
}

const { title, description = 'Veterinární ordinace Galen, Brno-Medlánky, Podpěrova 439/2' } =
  Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/img/icon.png', Astro.site)
const pathname = Astro.url.pathname
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" href="/img/icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Google Analytics is loaded only after the visitor accepts cookies in
      // the consent banner (src/components/CookieConsent), or on later visits
      // once the CookieConsent=true cookie is present.
      window.loadAnalytics = function () {
        if (window.__analyticsLoaded) return
        window.__analyticsLoaded = true
        var id = 'G-0GF8N4E27D'
        window.dataLayer = window.dataLayer || []
        window.gtag = function () {
          window.dataLayer.push(arguments)
        }
        window.gtag('js', new Date())
        window.gtag('config', id)
        var s = document.createElement('script')
        s.async = true
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id
        document.head.appendChild(s)
      }
      if (/(?:^|;\s*)CookieConsent(?:-legacy)?=true(?:;|$)/.test(document.cookie)) {
        window.loadAnalytics()
      }
    </script>
  </head>
  <body>
    <Navi pathname={pathname} />
    <div class="container-fluid">
      <div class="d-none d-md-block spacer-lg">&nbsp;</div>
      <div class="d-md-none spacer-md">&nbsp;</div>
      <slot />
    </div>
    <CookieConsent client:only="react" />
    <Footer />
    <script>
      import 'bootstrap'
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function (registrations) {
          registrations.forEach(function (r) {
            r.unregister()
          })
        })
        caches.keys().then(function (keys) {
          keys.forEach(function (key) {
            caches.delete(key)
          })
        })
      }
    </script>
  </body>
</html>
